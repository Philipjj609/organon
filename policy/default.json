    "extract": { "tier": "cheap", "model": "claude-haiku-5-5", "why": "Pulling fields or passages out of text already found." },
    "verify": { "tier": "cheap", "model": "claude-haiku-5-5", "why": "A different model than the producer: evaluators favour their own outputs." },
    "plan": { "tier": "strong", "model": "claude-opus-5-5", "why": "Deciding what to do and what it is worth." },
    "judge": { "tier": "strong", "model": "claude-opus-5-5", "why": "Weighing contested evidence; final calls." },
    "write": { "tier": "strong", "model": "claude-opus-5-5", "why": "Synthesis that enters memory or reaches a person." },
    "code": { "tier": "strong", "model": "claude-opus-5-5", "why": "Changing code that others will run." }
